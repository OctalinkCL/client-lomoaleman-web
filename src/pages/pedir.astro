---
// Carta para pedir (interna, en desarrollo). Lee la carta nueva: src/data/carta.json.
// El carro vive en el navegador (src/scripts/pedir.ts) y termina en un mensaje de WhatsApp.
// Plan: docs/PLAN-pedidos-whatsapp.md
import X from "@lucide/astro/icons/x";
import Layout from "@layouts/Layout.astro";
import CartaSection from "@components/CartaSection.astro";
import branchesData from "@data/branches.json";
import { loadCarta } from "@lib/carta";
import { branchDisplayName, type Branch } from "@lib/pedido";

const categories = loadCarta();

const branches: Branch[] = branchesData
  .filter((b) => !b.disabled)
  .map((b) => ({
    slug: b.slug,
    name: b.name,
    wsp: b.wsp || undefined,
    phone: b.phone || undefined,
    address: b.address || undefined,
  }))
  .sort((a, b) => branchDisplayName(a.name).localeCompare(branchDisplayName(b.name), "es"));

// "<" escapado para que el JSON no pueda cerrar la etiqueta <script>.
const data = JSON.stringify({ categories, branches }).replace(/</g, "\\u003c");

const sheet =
  "sheet w-full max-w-full sm:max-w-lg p-0 bg-neutral-950 text-white border-2 border-neutral-800 rounded-t-2xl sm:rounded-2xl backdrop:bg-black/70";
const closeButton = "shrink-0 w-9 h-9 inline-flex items-center justify-center rounded-full bg-neutral-800 hover:bg-neutral-700";
---

<Layout title="Pedir - Lomo Alemán">
  <main id="pedir" class="group container mx-auto px-4 py-8" data-orderable="pending">
    <div class="columns-1 md:columns-2 lg:columns-4 gap-4">
      {categories.map((category) => <CartaSection category={category} pedir />)}
    </div>
  </main>

  <!-- Barra fija: local elegido y acceso al pedido -->
  <div
    id="pedir-bar"
    class="fixed inset-x-0 bottom-0 z-40 bg-neutral-950/95 backdrop-blur border-t-2 border-neutral-800"
  >
    <div class="container mx-auto px-4 pt-3 pb-[max(0.75rem,env(safe-area-inset-bottom))] grid gap-2">
      <div class="flex items-center justify-between gap-3 text-sm">
        <p id="bar-branch" class="text-neutral-300">Cargando…</p>
        <button id="bar-change" type="button" class="hidden shrink-0 text-lomo underline underline-offset-2">
          Cambiar
        </button>
      </div>
      <button
        id="bar-pick"
        type="button"
        class="hidden w-full rounded-md bg-lomo text-black font-bold py-3 active:scale-[0.99] transition"
      >
        Elige tu local para pedir
      </button>
      <button
        id="bar-cart"
        type="button"
        class="hidden w-full rounded-md bg-lomo text-black font-bold py-3 active:scale-[0.99] transition"
      >
      </button>
      <a
        id="bar-call"
        class="hidden w-full text-center rounded-md bg-lomo text-black font-bold py-3"
        href="#"
      >
        Llamar
      </a>
    </div>
  </div>

  <!-- Aviso breve ("Agregado: …") -->
  <p
    id="pedir-toast"
    role="status"
    aria-live="polite"
    class="fixed left-1/2 -translate-x-1/2 bottom-36 z-40 px-4 py-2 rounded-full bg-white text-black text-sm font-semibold shadow-lg opacity-0 pointer-events-none transition-opacity"
  >
  </p>

  <!-- Elegir local -->
  <dialog id="branch-dialog" class={sheet} aria-labelledby="branch-title">
    <div class="flex flex-col flex-auto min-h-0">
      <header class="flex items-center justify-between gap-3 p-4 border-b border-neutral-800">
        <h2 id="branch-title" class="text-xl font-bold text-amber-500">¿A qué local pides?</h2>
        <button type="button" data-close class={closeButton} aria-label="Cerrar"><X class="w-5 h-5" /></button>
      </header>
      <ul id="branch-list" class="overflow-y-auto min-h-0 p-2"></ul>
    </div>
  </dialog>

  <!-- Armar un producto -->
  <dialog id="item-dialog" class={sheet} aria-labelledby="item-title">
    <div class="flex flex-col flex-auto min-h-0">
      <header class="flex items-start justify-between gap-3 p-4 border-b border-neutral-800">
        <div>
          <h2 id="item-title" class="text-xl font-bold text-amber-500"></h2>
          <p id="item-description" class="text-neutral-400 text-sm"></p>
        </div>
        <button type="button" data-close class={closeButton} aria-label="Cerrar"><X class="w-5 h-5" /></button>
      </header>
      <div id="item-body" class="overflow-y-auto min-h-0 p-4 grid gap-5"></div>
      <footer class="flex items-center gap-3 p-4 border-t border-neutral-800">
        <div class="flex items-center rounded-md border-2 border-neutral-700">
          <button id="item-minus" type="button" class="w-10 h-10 text-xl" aria-label="Menos">−</button>
          <span id="item-qty" class="w-8 text-center font-bold" aria-live="polite">1</span>
          <button id="item-plus" type="button" class="w-10 h-10 text-xl" aria-label="Más">+</button>
        </div>
        <button
          id="item-add"
          type="button"
          class="flex-1 rounded-md bg-lomo text-black font-bold py-3 disabled:bg-neutral-700 disabled:text-neutral-400"
        >
        </button>
      </footer>
    </div>
  </dialog>

  <!-- Ver y enviar el pedido -->
  <dialog id="cart-dialog" class={sheet} aria-labelledby="cart-title">
    <div class="flex flex-col flex-auto min-h-0">
      <header class="flex items-start justify-between gap-3 p-4 border-b border-neutral-800">
        <h2 id="cart-title" class="text-xl font-bold text-amber-500">Tu pedido</h2>
        <button type="button" data-close class={closeButton} aria-label="Cerrar"><X class="w-5 h-5" /></button>
      </header>

      <div id="cart-main" class="overflow-y-auto min-h-0">
        <ul id="cart-lines" class="divide-y divide-neutral-800 px-4"></ul>
        <p class="flex justify-between px-4 py-3 border-t border-neutral-800 font-bold">
          <span>Total referencial</span>
          <span id="cart-total"></span>
        </p>
        <p class="px-4 pb-3 text-right">
          <button id="cart-empty" type="button" class="text-sm text-red-400 underline underline-offset-2">
            Vaciar pedido
          </button>
        </p>

        <form id="cart-form" class="grid gap-4 p-4 border-t border-neutral-800" novalidate>
          <label class="grid gap-1">
            <span class="text-sm font-semibold">Nombre</span>
            <input
              name="name"
              autocomplete="given-name"
              maxlength="60"
              class="rounded-md bg-neutral-900 border-2 border-neutral-700 px-3 py-2"
            />
          </label>

          <fieldset class="grid gap-2">
            <legend class="text-sm font-semibold mb-1">Entrega</legend>
            <div class="grid grid-cols-2 gap-2">
              <label class="flex items-center gap-2 rounded-md border-2 border-neutral-700 px-3 py-2 has-[:checked]:border-lomo">
                <input type="radio" name="delivery" value="retiro" class="accent-amber-500" />
                Retiro en local
              </label>
              <label class="flex items-center gap-2 rounded-md border-2 border-neutral-700 px-3 py-2 has-[:checked]:border-lomo">
                <input type="radio" name="delivery" value="delivery" class="accent-amber-500" />
                Delivery
              </label>
            </div>
          </fieldset>

          <label id="address-field" class="hidden grid gap-1">
            <span class="text-sm font-semibold">Dirección</span>
            <input
              name="address"
              autocomplete="street-address"
              maxlength="120"
              placeholder="Calle, número, depto o referencia"
              class="rounded-md bg-neutral-900 border-2 border-neutral-700 px-3 py-2"
            />
          </label>

          <label class="grid gap-1">
            <span class="text-sm font-semibold">Medio de pago <span class="text-neutral-400 font-normal">(opcional)</span></span>
            <select name="payment" class="rounded-md bg-neutral-900 border-2 border-neutral-700 px-3 py-2">
              <option value="">Sin indicar</option>
              <option>Efectivo</option>
              <option>Transferencia</option>
              <option>Tarjeta</option>
            </select>
          </label>

          <label class="grid gap-1">
            <span class="text-sm font-semibold">Comentario <span class="text-neutral-400 font-normal">(opcional)</span></span>
            <textarea
              name="comment"
              rows="2"
              maxlength="200"
              class="rounded-md bg-neutral-900 border-2 border-neutral-700 px-3 py-2"
            ></textarea>
          </label>

          <div class="flex items-center justify-between gap-3 text-sm">
            <label class="flex items-center gap-2">
              <input type="checkbox" name="remember" checked class="accent-amber-500 w-4 h-4" />
              Recordar mis datos en este teléfono
            </label>
            <button id="cart-forget" type="button" class="hidden shrink-0 text-neutral-400 underline underline-offset-2">
              Olvidar
            </button>
          </div>

          <p id="cart-errors" class="hidden text-red-400 text-sm" role="alert"></p>

          <!-- Confirmación del local, a la vista justo antes de enviar -->
          <div class="flex items-start justify-between gap-3 rounded-md border-2 border-lomo/60 bg-neutral-900 p-3">
            <div>
              <p class="text-sm text-neutral-400">Enviarás este pedido a</p>
              <p id="cart-branch-name" class="text-lg font-bold"></p>
              <p id="cart-branch-address" class="text-sm text-neutral-400"></p>
            </div>
            <button id="cart-branch-change" type="button" class="shrink-0 text-lomo underline underline-offset-2">
              Cambiar
            </button>
          </div>

          <button id="cart-submit" type="submit" class="w-full rounded-md bg-[#25D366] text-black font-bold py-3">
            Enviar pedido por WhatsApp
          </button>
          <p class="text-neutral-400 text-xs text-center">
            Se abrirá WhatsApp con tu pedido escrito. El local confirma disponibilidad y total.
          </p>
        </form>
      </div>

      <!-- Después de enviar -->
      <div id="cart-sent" class="hidden p-6 grid gap-4 text-center">
        <p class="text-lg font-bold">Te llevamos a WhatsApp</p>
        <p class="text-neutral-300 text-sm">
          Si ya enviaste el mensaje, puedes vaciar el pedido. Si no se abrió WhatsApp, vuelve e
          inténtalo de nuevo.
        </p>
        <button id="cart-clear" type="button" class="w-full rounded-md bg-lomo text-black font-bold py-3">
          Ya lo envié, vaciar pedido
        </button>
        <button id="cart-back" type="button" class="w-full rounded-md border-2 border-neutral-700 py-3">
          Volver al pedido
        </button>
      </div>
    </div>
  </dialog>

  <!-- Al volver con un pedido que ya se envió -->
  <dialog id="sent-dialog" class={sheet} aria-labelledby="sent-title">
    <div class="flex flex-col flex-auto min-h-0 p-6 gap-4 text-center">
      <p id="sent-title" class="text-lg font-bold">Ya enviaste este pedido</p>
      <p id="sent-when" class="text-neutral-300 text-sm"></p>
      <button id="sent-new" type="button" class="w-full rounded-md bg-lomo text-black font-bold py-3">
        Empezar un pedido nuevo
      </button>
      <button id="sent-keep" type="button" class="w-full rounded-md border-2 border-neutral-700 py-3">
        Seguir con este pedido
      </button>
    </div>
  </dialog>

  <script is:inline type="application/json" id="pedir-data" set:html={data} />
</Layout>

<script>
  import "../scripts/pedir";
</script>

<style is:global>
  /* Espacio para que la barra fija no tape el final de la página */
  body {
    padding-bottom: 9rem;
  }

  /* Hojas: suben desde abajo en el celular y quedan centradas en pantallas grandes */
  dialog.sheet {
    margin: auto 0 0 0;
    max-height: 90dvh;
  }
  dialog.sheet[open] {
    display: flex;
    flex-direction: column;
  }
  @media (min-width: 640px) {
    dialog.sheet {
      margin: auto;
    }
  }
</style>
