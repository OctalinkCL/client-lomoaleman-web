---
import Layout from "@layouts/Layout.astro";
import MenuSection from "../components/MenuSection.astro";
import menuData from "../data/menu.json";
import liquidosData from "../data/liquidos.json";

// Filtrar secciones no disabled, ordenar por order
// Filtrar items no disabled dentro de cada sección, ordenar por order
const prepare = (data: any[]) =>
  data
    .filter((section: any) => !section.disabled)
    .sort((a: any, b: any) => a.order - b.order)
    .map((section: any) => ({
      ...section,
      items: section.items
        .filter((item: any) => !item.disabled)
        .sort((a: any, b: any) => a.order - b.order)
    }));

const menu = prepare(menuData);
// Solo sucursal Colón: se muestra cuando la URL trae ?sucursal=colon
const liquidos = prepare(liquidosData);
---

<Layout title="Carta - Lomo Alemán">
  <main class="container mx-auto px-4 py-8">
    <!-- <pre>{JSON.stringify(menu, null, 2)}</pre> -->

    {menu && menu.length > 0 ? (
      <div class="columns-1 md:columns-2 lg:columns-4 gap-4">
        {menu.map((section: any) => <MenuSection section={section} />)}
      </div>
    ) : (
      <div class="text-center py-16">
        <p class="text-amber-500 text-xl">Carta en construcción</p>
      </div>
    )}

    {liquidos.length > 0 && (
      <section id="colon-only" class="mt-8" hidden>
        <header class="mb-4 border-b-2 border-neutral-700 pb-2">
          <h2 class="text-amber-600 text-3xl font-semibold">Líquidos</h2>
          <p class="text-neutral-400 text-xs">Disponible en sucursal Colón</p>
        </header>
        <div class="columns-1 md:columns-2 lg:columns-4 gap-4">
          {liquidos.map((section: any) => <MenuSection section={section} />)}
        </div>
      </section>
    )}
  </main>
</Layout>

<script>
  // Mostrar contenido exclusivo de la sucursal Colón (llega con ?sucursal=colon desde el QR)
  const sucursal = new URLSearchParams(window.location.search).get("sucursal");
  if (sucursal === "colon") {
    document.getElementById("colon-only")?.removeAttribute("hidden");
  }
</script>
